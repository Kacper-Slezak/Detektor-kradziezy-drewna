# Skopiuj do .env i uzupełnij. NIE commituj pliku .env!
POSTGRES_PASSWORD=
# W Dockerze DATABASE_URL jest nadpisywany w docker-compose.yml (host: timescaledb).
# Poniższy adres jest tylko do uruchamiania API bez Dockera:
# DATABASE_URL=postgresql+asyncpg://detektor:<POSTGRES_PASSWORD>@localhost:5432/detektor
# Klucz dla POST /api/v1/ingest (nagłówek X-Ingest-Key). Pusty = bez zabezpieczenia (tylko lokalnie).
# Generowanie: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=
# Klucz AES-128 do odszyfrowania ramek z urządzeń: 32 znaki hex (16 B), ten sam co na płytce.
# Ustawiony = backend przyjmuje TYLKO zaszyfrowane ramki (jawne -> 422, także z symulatora i curl).
# Pusty = bez szyfrowania (np. lokalnie z symulatorem).
# Generowanie: python -c "import secrets; print(secrets.token_hex(16))"
FRAME_AES_KEY=
# Przyjmuj ramki wersji 1 i 2 (okres przejściowy). Ustaw false, gdy wszystkie płytki
# wysyłają wersję 3 (boot_id w nagłówku): wtedy ramki 1 i 2 -> 422. docs/backend/boot-id.md
LEGACY_FRAMES=true
TTN_WEBHOOK_SECRET=
FIREBASE_CREDENTIALS_PATH=
# Klucz do tokenów JWT. Generowanie: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# docker compose -f compose.prod.yml run --rm web python -m tools.generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
# Konto admina z `python -m app.seed`. Bez hasła zostanie wylosowane i wypisane w konsoli.
# SEED_ADMIN_LOGIN=admin
# SEED_ADMIN_PASSWORD=
# Hasło kont demo z `python -m app.seed --demo` (domyślnie demo-haslo-1).
# SEED_DEMO_PASSWORD=
