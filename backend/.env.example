# Skopiuj do .env i uzupełnij. NIE commituj pliku .env!
POSTGRES_PASSWORD=
# W Dockerze DATABASE_URL jest nadpisywany w docker-compose.yml (host: timescaledb).
# Poniższy adres jest tylko do uruchamiania API bez Dockera:
# DATABASE_URL=postgresql+asyncpg://detektor:<POSTGRES_PASSWORD>@localhost:5432/detektor
TTN_WEBHOOK_SECRET=
FIREBASE_CREDENTIALS_PATH=
# Klucz do tokenów JWT. Generowanie: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Konto admina z `python -m app.seed`. Bez hasła zostanie wylosowane i wypisane w konsoli.
# SEED_ADMIN_LOGIN=admin
# SEED_ADMIN_PASSWORD=
