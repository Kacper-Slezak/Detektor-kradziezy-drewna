# Jedno wejście do całej aplikacji (obraz detektor-web, frontend/Dockerfile.prod).
# HTTPS robi warstwa przed Caddy (np. wykr.es na Mikrusie), dlatego tu tylko HTTP.
# API_UPSTREAM: adres backendu, domyślnie serwis `web` z compose produkcyjnego.
{
	auto_https off
	admin off
}

:80 {
	encode gzip

	# API i Swagger idą do backendu
	@api path /api/* /health /docs /docs/* /openapi.json
	handle @api {
		reverse_proxy {$API_UPSTREAM:web:8000}
	}

	# reszta to aplikacja (SPA): nieznana ścieżka -> index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# pliki z /assets mają hash w nazwie, więc mogą być w cache na zawsze;
	# reszta (index.html, sw.js, manifest) zawsze świeża, inaczej PWA nie zobaczy nowej wersji
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@notassets not path /assets/* /api/* /health /docs /docs/* /openapi.json
	header @notassets Cache-Control "no-cache"
}
