# Obraz produkcyjny: zbudowana aplikacja + Caddy jako jedyne wejście (port 80 w kontenerze).
# Caddy podaje pliki z dist/ i przekazuje /api do backendu (Caddyfile).
# Do developmentu służy zwykły Dockerfile (vite dev).

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM caddy:2.10-alpine
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
EXPOSE 80
